#include <stdio.h>

int main() {
    int n, i, buscado, contador = 0;

    printf("Cuantos elementos tendra el arreglo? ");
    scanf("%d", &n);

    int arr[n];

    for (i = 0; i < n; i++) {
        printf("Elemento [%d]: ", i);
        scanf("%d", &arr[i]);
    }

    printf("Ingresa el numero a buscar: ");
    scanf("%d", &buscado);

    for (i = 0; i < n; i++) {
        if (arr[i] == buscado) {
            contador++;
        }
    }

    printf("El numero %d aparece %d veces en el arreglo.\n", buscado, contador);

    return 0;
}
