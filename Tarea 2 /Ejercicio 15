#include <stdio.h>

int main() {
    int n, i;
    int positivos = 0, negativos = 0, nulos = 0;

    printf("Cuantos elementos tendra el arreglo? ");
    scanf("%d", &n);

    int arr[n];

    for (i = 0; i < n; i++) {
        printf("Elemento [%d]: ", i);
        scanf("%d", &arr[i]);

        if (arr[i] > 0) {
            positivos++;
        } else if (arr[i] < 0) {
            negativos++;
        } else {
            nulos++;
        }
    }

    printf("Positivos: %d\n", positivos);
    printf("Negativos: %d\n", negativos);
    printf("Nulos: %d\n", nulos);

    return 0;
}
