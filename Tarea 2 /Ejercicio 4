#include <stdio.h>

int main() {
    float capital, tasa, monto_final;

    printf("Ingresa el capital invertido: ");
    scanf("%f", &capital);
    printf("Ingresa la tasa de interes mensual (en %%): ");
    scanf("%f", &tasa);

    monto_final = capital + (capital * (tasa / 100.0));

    printf("Monto al finalizar el mes: %.2f\n", monto_final);

    return 0;
}
